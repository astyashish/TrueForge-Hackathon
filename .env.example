# Threshold — environment variables
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local (or real keys in this file) to the repository.

# ============================================================
# Google Gemini (image + text generation)
# https://aistudio.google.com/apikey — image models need a billed key;
# the free tier's image quota is tiny.
# ============================================================
GEMINI_API_KEY=your_key_here

# Text model for world bible, level design, and NPC dialogue
TEXT_MODEL=gemini-3.5-flash

# Image model (Nano Banana 2 Lite for the hackathon)
IMAGE_MODEL=gemini-3.1-flash-lite-image

# ============================================================
# Sarvam AI (NPC and narrator voice) — https://platform.sarvam.ai
# ============================================================
SARVAM_API_KEY=your_key_here
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE=en-IN

# ============================================================
# Supabase persistence
# https://supabase.com/dashboard → Project Settings → API Keys
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ============================================================
# TrueForge Agent Harness (local mode)
# start.bat runs it for you; or: npm run services
# ============================================================
TRUEFORGE_SERVER_URL=http://localhost:8790
# Model FQN the crew agents use (provider/model). Leave empty to use the
# first model configured in TrueForge.
# TRUEFORGE_MODEL=google-gemini/gemini-3-6-flash
# MCP server names (TrueForge → Connectors) the Cost Janitor may reach.
# CLOUD_MCP_SERVERS=
# TRUEFORGE_API_KEY=  # Only needed if TrueForge auth is enabled (not in local mode)

# ============================================================
# Game settings
# ============================================================
# 0 = gallery-only (no new world creation)
FREE_GAME_LIMIT=3

# Wall-clock session budget per world play-through (seconds)
NEXT_PUBLIC_SESSION_TIME_LIMIT_SEC=600

# ============================================================
# Analytics (optional)
# ============================================================
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
